# ⚠️ INSTRUÇÕES:
# 1. Copie este arquivo para .env
# 2. Preencha com a URL do seu backend
# 3. Este arquivo pode ser commitado (apenas o .env é ignorado)

# ========================================
# URL da API Backend
# ========================================

# Para desenvolvimento LOCAL:
# Use o IP da sua máquina na rede local (descubra com ipconfig no Windows ou ifconfig no Linux/Mac)
# NÃO use localhost ou 127.0.0.1 (não funciona no celular)
API_URL=http://192.168.1.10:3333

# Para PRODUÇÃO (Railway):
# Descomente a linha abaixo e comente a linha acima
# API_URL=https://backendtcc-production.up.railway.app

# ========================================
# Como descobrir seu IP local:
# ========================================
# Windows: ipconfig
# Linux/Mac: ifconfig ou ip addr show
# 
# Procure pelo endereço IPv4 da sua conexão ativa
# Exemplo: 192.168.1.10, 192.168.0.15, etc.
