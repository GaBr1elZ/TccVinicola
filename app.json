{
  "expo": {
    "name": "Vinícola App",
    "slug": "vinicolaapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/iconApp.jpg",
    "scheme": "vinicolaapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/iconApp.jpg",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.gabrielmachadocalegari.TestesTccVinicolaMobile"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/iconApp.jpg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/iconApp.jpg",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8b3428a0-9e45-4557-9d6f-6e44a41e867a"
      },
      "apiUrl": "https://backend-tcc-production-9d24.up.railway.app"
    }
  }
}
